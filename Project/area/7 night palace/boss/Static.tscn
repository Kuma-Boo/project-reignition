[sub_resource type="GDScript" id="GDScript_iowwo"]
script/source = "extends ColorRect

@export var sun_target_path: NodePath
@export var depth_viewport_path: NodePath

@onready var depth_viewport: SubViewport = get_node(depth_viewport_path)
@onready var sun_target: Node3D = get_node(sun_target_path)

func _ready() -> void:
	process_priority = 100
	material.set_shader_parameter(\"depth_tex\", depth_viewport.get_texture())

func _process(_delta: float) -> void:
	var active_cam: Camera3D = get_tree().root.get_camera_3d()
	if not active_cam or not sun_target:
		return

	var cam_forward: Vector3 = -active_cam.global_basis.z
	var target_pos: Vector3 = sun_target.global_position

	if active_cam.is_position_behind(target_pos):
		material.set_shader_parameter(\"light_source_pos\", Vector2(-99999, -99999))
		material.set_shader_parameter(\"camera_dir\", cam_forward)
		return

	var sun_dir: Vector3 = (target_pos - active_cam.global_position).normalized()
	material.set_shader_parameter(\"light_source_dir\", sun_dir)

	var pos: Vector2 = active_cam.unproject_position(target_pos)
	var viewport_size: Vector2 = get_viewport().get_visible_rect().size
	var pos_uv: Vector2 = pos / viewport_size

	material.set_shader_parameter(\"light_source_pos\", pos_uv)
	material.set_shader_parameter(\"camera_dir\", cam_forward)
"

